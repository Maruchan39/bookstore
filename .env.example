PORT="8080"
DB_URL="bookstore:bookstore@tcp(127.0.0.1:3306)/bookstore?parseTime=true"
JWT_SECRET="replace-with-a-long-random-secret"

# Docker Compose MySQL settings.
MYSQL_CONTAINER_NAME="bookstore-mysql"
MYSQL_DATABASE="bookstore"
MYSQL_USER="bookstore"
MYSQL_PASSWORD="bookstore"
MYSQL_ROOT_PASSWORD="replace-with-a-local-root-password"
